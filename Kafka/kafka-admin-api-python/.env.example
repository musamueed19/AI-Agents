# Kafka broker servers
BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
LOCATION_TOPIC_NAME=location_topic
# Location topic partition count
LOCATION_TOPIC_PARTITION_COUNT=3
# Location topic replication factor
LOCATION_TOPIC_REPLICATION_FACTOR=3
# Location topic cleanup policy
LOCATION_TOPIC_CLEANUP_POLICY=delete
# Location topic compression type
LOCATION_TOPIC_COMPRESSION_TYPE=snappy
# Location topic max message bytes
LOCATION_TOPIC_MAX_MESSAGE_BYTES=1000000
# Location topic retention time
LOCATION_TOPIC_RETENTION_TIME=1000000 # 1 day